rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Hardened Helpers (Phase 3)
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Zero-DB-read bootstrapped admin check (safe inside allow list)
    function isBootstrappedAdmin() {
      return isVerifiedUser() &&
        request.auth.token.email is string &&
        request.auth.token.email == 'nomigosone@gmail.com';
    }

    // Full RBAC admin check (bootstrapped admin OR trusted /admins/{uid} document)
    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isOptionalNumber(data, field, minVal) {
      return !(field in data) || (data[field] is number && data[field] >= minVal);
    }

    function isValidPaymentMethod(val) {
      return val in [
        'telegram_bank',
        'bank_transfer',
        'qris',
        'va_bca',
        'va_mandiri',
        'ewallet_gopay',
        'ewallet_dana'
      ];
    }

    function isValidOrderStatus(val) {
      return val in [
        'AWAITING_BANK',
        'PENDING',
        'PAYMENT_SUBMITTED',
        'PAID',
        'CANCELLED'
      ];
    }

    function isValidSocialLinks(sl) {
      return sl is map &&
        sl.keys().hasOnly(['youtube', 'tiktok', 'instagram', 'whatsapp']) &&
        sl.size() == 4 &&
        sl.youtube is string && sl.youtube.size() <= 300 &&
        sl.tiktok is string && sl.tiktok.size() <= 300 &&
        sl.instagram is string && sl.instagram.size() <= 300 &&
        sl.whatsapp is string && sl.whatsapp.size() <= 300;
    }

    function isValidUiTexts(u) {
      return u is map &&
        u.keys().hasOnly([
          'navCatalog', 'navFeatures', 'navCart',
          'catalogTitle', 'catalogSubtitle',
          'featuresTitle', 'featuresSubtitle',
          'buyButtonText', 'detailButtonText'
        ]) &&
        u.size() == 9 &&
        u.navCatalog is string && u.navCatalog.size() <= 40 &&
        u.navFeatures is string && u.navFeatures.size() <= 40 &&
        u.navCart is string && u.navCart.size() <= 40 &&
        u.catalogTitle is string && u.catalogTitle.size() <= 120 &&
        u.catalogSubtitle is string && u.catalogSubtitle.size() <= 300 &&
        u.featuresTitle is string && u.featuresTitle.size() <= 180 &&
        u.featuresSubtitle is string && u.featuresSubtitle.size() <= 360 &&
        u.buyButtonText is string && u.buyButtonText.size() <= 30 &&
        u.detailButtonText is string && u.detailButtonText.size() <= 30;
    }

    function isValidTheme(t) {
      return t is map &&
        t.keys().hasOnly([
          'storeName', 'heroEyebrow', 'heroHeadline', 'heroSubheadline', 'heroCtaText',
          'heroImage', 'accentColor', 'defaultMode', 'cornerStyle', 'gridColumns',
          'contactEmail', 'footerNotice', 'socialLinks', 'uiTexts'
        ]) &&
        t.storeName is string && t.storeName.size() >= 1 && t.storeName.size() <= 100 &&
        t.heroEyebrow is string && t.heroEyebrow.size() <= 120 &&
        t.heroHeadline is string && t.heroHeadline.size() <= 240 &&
        t.heroSubheadline is string && t.heroSubheadline.size() <= 600 &&
        t.heroCtaText is string && t.heroCtaText.size() <= 60 &&
        t.heroImage is string && t.heroImage.size() <= 500 &&
        t.accentColor is string && t.accentColor.size() <= 20 &&
        t.defaultMode in ['light', 'dark'] &&
        t.cornerStyle in ['sharp', 'modern', 'soft'] &&
        t.gridColumns in [2, 3] &&
        t.contactEmail is string && t.contactEmail.size() <= 160 &&
        t.footerNotice is string && t.footerNotice.size() <= 300 &&
        (!('socialLinks' in t) || isValidSocialLinks(t.socialLinks)) &&
        (!('uiTexts' in t) || isValidUiTexts(t.uiTexts));
    }

    function isValidSeo(s) {
      return s is map &&
        s.keys().hasOnly(['metaTitle', 'metaDescription', 'keywords', 'canonicalUrl', 'ogSiteName']) &&
        s.size() == 5 &&
        s.metaTitle is string && s.metaTitle.size() <= 160 &&
        s.metaDescription is string && s.metaDescription.size() <= 400 &&
        s.keywords is string && s.keywords.size() <= 400 &&
        s.canonicalUrl is string && s.canonicalUrl.size() <= 300 &&
        s.ogSiteName is string && s.ogSiteName.size() <= 100;
    }

    function isValidPayment(p) {
      return p is map &&
        p.keys().hasOnly([
          'provider', 'merchantName', 'qrisMerchantId', 'qrisImageUrl',
          'expiryMinutes', 'autoConfirmDemo', 'methods'
        ]) &&
        p.size() == 7 &&
        p.provider in ['builtin_auto', 'midtrans', 'tripay', 'xendit'] &&
        p.merchantName is string && p.merchantName.size() >= 1 && p.merchantName.size() <= 120 &&
        p.qrisMerchantId is string && p.qrisMerchantId.size() <= 80 &&
        p.qrisImageUrl is string && p.qrisImageUrl.size() <= 500 &&
        p.expiryMinutes is number && p.expiryMinutes >= 5 && p.expiryMinutes <= 1440 &&
        p.autoConfirmDemo is bool &&
        p.methods is list && p.methods.size() >= 1 && p.methods.size() <= 10 &&
        p.methods[0] is map;
    }

    // =========================================================================
    // Entity Validation Blueprints (Pillar 2 & Pillar 5)
    // =========================================================================
    function isValidProduct(data, productId) {
      return data.keys().hasAll([
          'id', 'slug', 'title', 'category', 'price', 'stock', 'unlimitedStock',
          'shortDescription', 'description', 'highlights', 'format', 'fileSize',
          'fileName', 'fileKey', 'coverImage', 'status', 'featured', 'salesCount',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'slug', 'title', 'category', 'price', 'originalPrice', 'stock',
          'unlimitedStock', 'shortDescription', 'description', 'highlights',
          'format', 'fileSize', 'fileName', 'fileKey', 'coverImage', 'status',
          'featured', 'salesCount', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id == productId && isValidId(data.id) &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 160 &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 160 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.price is number && data.price >= 0 && data.price <= 1000000000 &&
        isOptionalNumber(data, 'originalPrice', 0) &&
        data.stock is number && data.stock >= -1 && data.stock <= 1000000 &&
        data.unlimitedStock is bool &&
        data.shortDescription is string && data.shortDescription.size() <= 400 &&
        data.description is string && data.description.size() <= 4000 &&
        data.highlights is list && data.highlights.size() <= 20 &&
        (data.highlights.size() == 0 || (data.highlights[0] is string && data.highlights[0].size() <= 240)) &&
        data.format is string && data.format.size() <= 80 &&
        data.fileSize is string && data.fileSize.size() <= 40 &&
        data.fileName is string && data.fileName.size() <= 200 &&
        data.fileKey is string && data.fileKey.size() <= 200 &&
        data.coverImage is string && data.coverImage.size() <= 500 &&
        data.status in ['active', 'draft'] &&
        data.featured is bool &&
        data.salesCount is number && data.salesCount >= 0 && data.salesCount <= 10000000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProductLink(data, productId) {
      return data.keys().hasAll(['productId', 'downloadUrl', 'updatedAt']) &&
        data.keys().hasOnly(['productId', 'downloadUrl', 'updatedAt']) &&
        data.productId is string && data.productId == productId && isValidId(data.productId) &&
        data.downloadUrl is string && data.downloadUrl.size() <= 600 &&
        (data.downloadUrl.size() == 0 || (
          data.downloadUrl.size() >= 8 &&
          (data.downloadUrl[0:8] == 'https://' || data.downloadUrl[0:7] == 'http://')
        )) &&
        data.updatedAt is timestamp;
    }

    function isValidPublicSettings(data) {
      return data.keys().hasAll(['theme', 'seo', 'payment', 'categories', 'updatedAt']) &&
        data.keys().hasOnly(['theme', 'seo', 'payment', 'categories', 'updatedAt']) &&
        isValidTheme(data.theme) &&
        isValidSeo(data.seo) &&
        isValidPayment(data.payment) &&
        data.categories is list && data.categories.size() >= 1 && data.categories.size() <= 30 &&
        data.categories[0] is string && data.categories[0].size() <= 80 &&
        data.updatedAt is timestamp;
    }

    function isValidAdminSettings(data) {
      return data.keys().hasAll([
          'notifyOnOrderCreated', 'notifyOnOrderPaid', 'notifyOnLowStock',
          'lowStockThreshold', 'customChatIdOverride', 'messageHeader', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'notifyOnOrderCreated', 'notifyOnOrderPaid', 'notifyOnLowStock',
          'lowStockThreshold', 'customChatIdOverride', 'messageHeader', 'updatedAt'
        ]) &&
        data.notifyOnOrderCreated is bool &&
        data.notifyOnOrderPaid is bool &&
        data.notifyOnLowStock is bool &&
        data.lowStockThreshold is number && data.lowStockThreshold >= 1 && data.lowStockThreshold <= 100 &&
        data.customChatIdOverride is string && data.customChatIdOverride.size() <= 64 &&
        data.messageHeader is string && data.messageHeader.size() <= 160 &&
        data.updatedAt is timestamp;
    }

    function isValidOrder(data, orderId) {
      return data.keys().hasAll([
          'id', 'invoiceCode', 'buyerSecret', 'customerName', 'customerEmail',
          'customerPhone', 'paymentMethod', 'paymentReference', 'items',
          'totalAmount', 'status', 'downloadToken', 'telegramStatus',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'invoiceCode', 'buyerSecret', 'customerName', 'customerEmail',
          'customerPhone', 'paymentMethod', 'paymentReference', 'items',
          'totalAmount', 'status', 'downloadToken', 'telegramStatus',
          'telegramMessage', 'telegramOrderMessageId', 'telegramTransferMessageId',
          'adminBankName', 'adminBankNumber', 'adminBankHolder', 'adminTransferAmount',
          'transferProofNote', 'bankSyncSecret', 'transferSyncSecret',
          'downloadLinks', 'deliveryNote',
          'createdAt', 'updatedAt', 'paidAt'
        ]) &&
        data.id is string && data.id == orderId && isValidId(data.id) &&
        data.invoiceCode is string && data.invoiceCode.size() >= 4 && data.invoiceCode.size() <= 64 &&
        data.buyerSecret is string && data.buyerSecret.size() >= 16 && data.buyerSecret.size() <= 128 &&
        data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 120 &&
        data.customerEmail is string && data.customerEmail.size() >= 5 && data.customerEmail.size() <= 160 &&
        data.customerPhone is string && data.customerPhone.size() >= 6 && data.customerPhone.size() <= 64 &&
        isValidPaymentMethod(data.paymentMethod) &&
        data.paymentReference is string && data.paymentReference.size() <= 100 &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 20 &&
        data.items[0] is map &&
        data.totalAmount is number && data.totalAmount >= 0 && data.totalAmount <= 1000000000 &&
        isValidOrderStatus(data.status) &&
        data.downloadToken is string && data.downloadToken.size() <= 128 &&
        data.telegramStatus in ['sent', 'not_configured', 'failed', 'pending'] &&
        isOptionalString(data, 'telegramMessage', 500) &&
        isOptionalNumber(data, 'telegramOrderMessageId', 0) &&
        isOptionalNumber(data, 'telegramTransferMessageId', 0) &&
        isOptionalString(data, 'adminBankName', 80) &&
        isOptionalString(data, 'adminBankNumber', 40) &&
        isOptionalString(data, 'adminBankHolder', 120) &&
        isOptionalNumber(data, 'adminTransferAmount', 0) &&
        isOptionalString(data, 'transferProofNote', 200) &&
        isOptionalString(data, 'bankSyncSecret', 128) &&
        isOptionalString(data, 'transferSyncSecret', 128) &&
        (!('downloadLinks' in data) || (
          data.downloadLinks is list && data.downloadLinks.size() <= 20 &&
          (data.downloadLinks.size() == 0 || data.downloadLinks[0] is map)
        )) &&
        isOptionalString(data, 'deliveryNote', 300) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        (!('paidAt' in data) || data.paidAt is timestamp);
    }

    function isValidOrderStatusDoc(data, orderId) {
      return data.keys().hasAll([
          'orderId', 'invoiceCode', 'paymentMethod', 'status',
          'totalAmount', 'downloadReady', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'orderId', 'invoiceCode', 'paymentMethod', 'status',
          'totalAmount', 'adminBankName', 'adminBankNumber', 'adminBankHolder',
          'adminTransferAmount', 'transferProofNote', 'downloadReady',
          'downloadLinks', 'deliveryNote',
          'createdAt', 'updatedAt'
        ]) &&
        data.orderId is string && data.orderId == orderId && isValidId(data.orderId) &&
        data.invoiceCode is string && data.invoiceCode.size() >= 4 && data.invoiceCode.size() <= 64 &&
        isValidPaymentMethod(data.paymentMethod) &&
        isValidOrderStatus(data.status) &&
        data.totalAmount is number && data.totalAmount >= 0 && data.totalAmount <= 1000000000 &&
        isOptionalString(data, 'adminBankName', 80) &&
        isOptionalString(data, 'adminBankNumber', 40) &&
        isOptionalString(data, 'adminBankHolder', 120) &&
        isOptionalNumber(data, 'adminTransferAmount', 0) &&
        isOptionalString(data, 'transferProofNote', 200) &&
        data.downloadReady is bool &&
        (!('downloadLinks' in data) || (
          data.downloadLinks is list && data.downloadLinks.size() <= 20 &&
          (data.downloadLinks.size() == 0 || data.downloadLinks[0] is map)
        )) &&
        isOptionalString(data, 'deliveryNote', 300) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTelegramLog(data, logId) {
      return data.keys().hasAll(['id', 'timestamp', 'event', 'status', 'detail', 'preview']) &&
        data.keys().hasOnly(['id', 'timestamp', 'event', 'orderId', 'status', 'detail', 'preview']) &&
        data.id is string && data.id == logId && isValidId(data.id) &&
        data.timestamp is timestamp &&
        data.event in ['order_created', 'transfer_submitted', 'order_paid', 'low_stock', 'test', 'help'] &&
        isOptionalString(data, 'orderId', 128) &&
        data.status in ['sent', 'not_configured', 'failed'] &&
        data.detail is string && data.detail.size() <= 300 &&
        data.preview is string && data.preview.size() <= 1500;
    }

    function isValidAdminUser(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'role', 'createdAt']) &&
        data.uid is string && data.uid == uid && isValidId(data.uid) &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 160 &&
        data.role == 'admin' &&
        data.createdAt is timestamp;
    }

    function isSafeMediaUrl(url, sourceType) {
      return url is string && (
        (
          sourceType == 'url' &&
          url.size() >= 8 &&
          url.size() <= 500 &&
          url[0:8] == 'https://'
        ) || (
          sourceType == 'upload' &&
          url.size() >= 24 &&
          url.size() <= 280000 &&
          (
            url[0:23] == 'data:image/jpeg;base64,' ||
            url[0:23] == 'data:image/webp;base64,' ||
            url[0:22] == 'data:image/png;base64,'
          )
        )
      );
    }

    function isValidMediaAsset(data, assetId) {
      return data.keys().hasAll([
          'id', 'label', 'category', 'sourceType', 'url', 'mimeType',
          'width', 'height', 'sizeBytes', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'label', 'category', 'sourceType', 'url', 'mimeType',
          'width', 'height', 'sizeBytes', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id == assetId && isValidId(data.id) &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 120 &&
        data.category in ['product', 'hero', 'general'] &&
        data.sourceType in ['upload', 'url'] &&
        isSafeMediaUrl(data.url, data.sourceType) &&
        data.mimeType is string && data.mimeType.size() >= 3 && data.mimeType.size() <= 40 &&
        data.width is number && data.width >= 0 && data.width <= 4096 &&
        data.height is number && data.height >= 0 && data.height <= 4096 &&
        data.sizeBytes is number && data.sizeBytes >= 0 && data.sizeBytes <= 280000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // =========================================================================
    // Collection Rules (Denial-of-Wallet Order: Auth -> Static -> Relational)
    // =========================================================================

    // 1. Products Catalog (Public active catalog; no private download URLs)
    match /products/{productId} {
      allow get: if isValidId(productId) && (existing().status == 'active' || isAdmin());
      allow list: if existing().status == 'active' || isBootstrappedAdmin();

      allow create: if isVerifiedUser() &&
        isValidId(productId) &&
        isValidProduct(incoming(), productId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if isVerifiedUser() &&
        isValidId(productId) &&
        isValidProduct(incoming(), productId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow delete: if isVerifiedUser() && isValidId(productId) && isAdmin();
    }

    // 1B. Private Product Download Links (Strictly Admin-Only — Never Publicly Readable)
    match /productLinks/{productId} {
      allow get: if isVerifiedUser() && isValidId(productId) && isAdmin();
      allow list: if isBootstrappedAdmin();

      allow create: if isVerifiedUser() &&
        isValidId(productId) &&
        isValidProductLink(incoming(), productId) &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if isVerifiedUser() &&
        isValidId(productId) &&
        isValidProductLink(incoming(), productId) &&
        incoming().productId == existing().productId &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow delete: if isVerifiedUser() && isValidId(productId) && isAdmin();
    }

    // 2. Public Storefront Settings (/publicSettings/store)
    match /publicSettings/{configId} {
      allow get: if isValidId(configId) && configId == 'store';
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidId(configId) &&
        configId == 'store' &&
        isValidPublicSettings(incoming()) &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if isVerifiedUser() &&
        isValidId(configId) &&
        configId == 'store' &&
        isValidPublicSettings(incoming()) &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow delete: if false;
    }

    // 3. Admin-Only Settings (/adminSettings/telegram)
    match /adminSettings/{configId} {
      allow get: if isVerifiedUser() && isValidId(configId) && configId == 'telegram' && isAdmin();
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidId(configId) &&
        configId == 'telegram' &&
        isValidAdminSettings(incoming()) &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if isVerifiedUser() &&
        isValidId(configId) &&
        configId == 'telegram' &&
        isValidAdminSettings(incoming()) &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow delete: if false;
    }

    // 4. Orders (Contains Buyer PII — Admin-Only Reads; Single-Use Buyer Capability Proof on Updates)
    match /orders/{orderId} {
      allow get: if isVerifiedUser() && isValidId(orderId) && isAdmin();
      allow list: if isBootstrappedAdmin();

      // Buyers create a new unpaid order atomically paired with /orderStatuses/{orderId}
      allow create: if isValidId(orderId) &&
        isValidOrder(incoming(), orderId) &&
        incoming().status in ['AWAITING_BANK', 'PENDING'] &&
        !('paidAt' in incoming()) &&
        !('bankSyncSecret' in incoming()) &&
        !('transferSyncSecret' in incoming()) &&
        !('downloadLinks' in incoming()) &&
        !('deliveryNote' in incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/orderStatuses/$(orderId)) &&
        getAfter(/databases/$(database)/documents/orderStatuses/$(orderId)).data.status == incoming().status &&
        getAfter(/databases/$(database)/documents/orderStatuses/$(orderId)).data.downloadReady == false;

      // Action-Based Update Pattern + Terminal State Locking + Cryptographic Capability Proof
      allow update: if isValidId(orderId) &&
        isValidOrder(incoming(), orderId) &&
        incoming().id == existing().id &&
        incoming().invoiceCode == existing().invoiceCode &&
        incoming().buyerSecret == existing().buyerSecret &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Tier 1: Admin full order management (send bank details, verify PAID + unlock downloadLinks, cancel, resend Telegram)
          (isVerifiedUser() && isAdmin()) ||
          // Tier 2A: Buyer holding exact buyerSecret syncs bank instructions received from Telegram (AWAITING_BANK -> PENDING)
          (
            existing().status == 'AWAITING_BANK' &&
            incoming().status == 'PENDING' &&
            !('bankSyncSecret' in existing()) &&
            'bankSyncSecret' in incoming() &&
            incoming().bankSyncSecret == existing().buyerSecret &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'adminBankName', 'adminBankNumber', 'adminBankHolder',
              'adminTransferAmount', 'bankSyncSecret', 'updatedAt'
            ]) &&
            getAfter(/databases/$(database)/documents/orderStatuses/$(orderId)).data.status == 'PENDING' &&
            getAfter(/databases/$(database)/documents/orderStatuses/$(orderId)).data.downloadReady == false
          ) ||
          // Tier 2B: Buyer holding exact buyerSecret submits transfer proof (PENDING -> PAYMENT_SUBMITTED)
          (
            existing().status == 'PENDING' &&
            incoming().status == 'PAYMENT_SUBMITTED' &&
            !('transferSyncSecret' in existing()) &&
            'transferSyncSecret' in incoming() &&
            incoming().transferSyncSecret == existing().buyerSecret &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'transferProofNote', 'telegramStatus', 'telegramMessage',
              'telegramTransferMessageId', 'transferSyncSecret', 'updatedAt'
            ]) &&
            getAfter(/databases/$(database)/documents/orderStatuses/$(orderId)).data.status == 'PAYMENT_SUBMITTED' &&
            getAfter(/databases/$(database)/documents/orderStatuses/$(orderId)).data.downloadReady == false
          )
        );

      allow delete: if isVerifiedUser() && isValidId(orderId) && isAdmin();
    }

    // 5. OrderStatuses (PII-Free Real-Time Buyer Mirror — Exact ID Get Only, No Public List)
    match /orderStatuses/{orderId} {
      allow get: if isValidId(orderId);
      allow list: if isBootstrappedAdmin();

      allow create: if isValidId(orderId) &&
        isValidOrderStatusDoc(incoming(), orderId) &&
        incoming().status in ['AWAITING_BANK', 'PENDING'] &&
        incoming().downloadReady == false &&
        !('downloadLinks' in incoming()) &&
        !('deliveryNote' in incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/orders/$(orderId));

      allow update: if isValidId(orderId) &&
        isValidOrderStatusDoc(incoming(), orderId) &&
        incoming().orderId == existing().orderId &&
        incoming().invoiceCode == existing().invoiceCode &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Tier 1: Admin updates status (including PAID, downloadReady: true, downloadLinks, deliveryNote)
          (isVerifiedUser() && isAdmin()) ||
          // Tier 2A: Synchronized atomically with parent /orders/{orderId} verified by bankSyncSecret
          (
            existing().status == 'AWAITING_BANK' &&
            incoming().status == 'PENDING' &&
            incoming().downloadReady == false &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'adminBankName', 'adminBankNumber', 'adminBankHolder', 'adminTransferAmount', 'updatedAt'
            ]) &&
            getAfter(/databases/$(database)/documents/orders/$(orderId)).data.status == 'PENDING'
          ) ||
          // Tier 2B: Synchronized atomically with parent /orders/{orderId} verified by transferSyncSecret
          (
            existing().status == 'PENDING' &&
            incoming().status == 'PAYMENT_SUBMITTED' &&
            incoming().downloadReady == false &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'transferProofNote', 'updatedAt'
            ]) &&
            getAfter(/databases/$(database)/documents/orders/$(orderId)).data.status == 'PAYMENT_SUBMITTED'
          )
        );

      allow delete: if isValidId(orderId) && isAdmin();
    }

    // 6. Telegram Audit Logs (Admin-Only)
    match /telegramLogs/{logId} {
      allow get: if isVerifiedUser() && isValidId(logId) && isAdmin();
      allow list: if isBootstrappedAdmin();

      allow create: if isVerifiedUser() &&
        isValidId(logId) &&
        isValidTelegramLog(incoming(), logId) &&
        incoming().timestamp == request.time &&
        isAdmin();

      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(logId) && isAdmin();
    }

    // 7. Trusted Admin Registry (Bootstrapped Admin Only)
    match /admins/{uid} {
      allow get: if isVerifiedUser() && isValidId(uid) && (isBootstrappedAdmin() || request.auth.uid == uid);
      allow list: if isBootstrappedAdmin();

      allow create: if isVerifiedUser() &&
        isValidId(uid) &&
        isValidAdminUser(incoming(), uid) &&
        incoming().createdAt == request.time &&
        isBootstrappedAdmin();

      allow update: if isVerifiedUser() &&
        isValidId(uid) &&
        isValidAdminUser(incoming(), uid) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        isBootstrappedAdmin();

      allow delete: if isVerifiedUser() && isValidId(uid) && isBootstrappedAdmin();
    }

    // 8. Media Assets Gallery (Public single-doc get by exact assetId; Admin-only list & CRUD)
    match /mediaAssets/{assetId} {
      allow get: if isValidId(assetId);
      allow list: if isBootstrappedAdmin();

      allow create: if isVerifiedUser() &&
        isValidId(assetId) &&
        isValidMediaAsset(incoming(), assetId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if isVerifiedUser() &&
        isValidId(assetId) &&
        isValidMediaAsset(incoming(), assetId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow delete: if isVerifiedUser() && isValidId(assetId) && isAdmin();
    }
  }
}
