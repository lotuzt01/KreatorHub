  <!-- =====================================================================
       JAVASCRIPT RENDERER & INTERACTIVITY
  ====================================================================== -->
  <script>
    // Format angka ke mata uang Rupiah
    function formatRupiah(amount) {
      return new Intl.NumberFormat('id-ID', {
        style: 'currency',
        currency: 'IDR',
        maximumFractionDigits: 0
      }).format(amount);
    }

    // Ekstrak ID YouTube jika user memasukkan URL penuh maupun ID saja
    function parseYouTubeId(input) {
      if (!input) return '';
      const trimmed = input.trim();
      const regExp = /(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/;
      const match = trimmed.match(regExp);
      return match ? match[1] : trimmed;
    }

    // Render seluruh halaman berdasarkan PRODUCT_CONFIG
    function renderLandingPage() {
      const cfg = PRODUCT_CONFIG;
      document.title = `${cfg.titleLine1} ${cfg.titleLine2}`;

      // Hero
      document.getElementById('el-badgeTop').textContent = cfg.badgeTop;
      document.getElementById('el-titleLine1').textContent = cfg.titleLine1;
      document.getElementById('el-titleLine2').textContent = cfg.titleLine2;
      document.getElementById('el-subtitle').textContent = cfg.subtitle;
      document.getElementById('el-pillBadge').textContent = cfg.pillBadge;
      document.getElementById('el-heroCtaText').textContent = cfg.heroCtaText;
      document.getElementById('el-heroMicroCopy').textContent = cfg.heroMicroCopy;

      // Top Video Showcase
      document.getElementById('el-showcaseHeading').textContent = cfg.showcaseHeading;
      document.getElementById('el-showcaseSubheading').textContent = cfg.showcaseSubheading;
      const topVideosEl = document.getElementById('el-topVideosContainer');
      topVideosEl.innerHTML = cfg.topVideos.map(v => {
        const vidId = parseYouTubeId(v.youtubeId);
        return `
          <div class="video-frame-glow">
            <div class="rounded-[1rem] bg-slate-950 overflow-hidden">
              <div class="aspect-video w-full bg-black">
                <iframe
                  class="w-full h-full"
                  src="https://www.youtube.com/embed/${vidId}?rel=0"
                  title="${v.label}"
                  loading="lazy"
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
              <div class="px-3.5 py-2 bg-slate-900/95 flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-200 truncate">${v.label}</span>
                <span class="text-[10px] font-bold text-cyan-400 shrink-0">▶ Contoh Video</span>
              </div>
            </div>
          </div>
        `;
      }).join('');

      // Pain Points
      document.getElementById('el-painHeading').textContent = cfg.painHeading;
      document.getElementById('el-painList').innerHTML = cfg.painPoints.map(item => `
        <li class="py-2.5 flex items-start gap-3">
          <span class="text-base leading-none mt-0.5">${item.icon}</span>
          <span class="text-xs sm:text-sm text-slate-200 leading-snug">${item.text}</span>
        </li>
      `).join('');

      // Solution & Features
      document.getElementById('el-solutionEyebrow').textContent = cfg.solutionEyebrow;
      document.getElementById('el-solutionTitlePart1').textContent = cfg.solutionTitlePart1;
      document.getElementById('el-solutionTitlePart2').textContent = cfg.solutionTitlePart2;
      document.getElementById('el-solutionDesc').textContent = cfg.solutionDesc;

      document.getElementById('el-featuresHeading').textContent = cfg.featuresHeading;
      document.getElementById('el-featuresSubheading').textContent = cfg.featuresSubheading;
      document.getElementById('el-featuresList').innerHTML = cfg.features.map(f => `
        <div class="rounded-2xl bg-gradient-to-br ${f.cardStyle} border p-4 shadow-lg backdrop-blur-sm">
          <div class="text-xl mb-1.5">${f.icon}</div>
          <h4 class="font-display font-bold text-sm text-cyan-300 mb-1">${f.title}</h4>
          <p class="text-xs text-slate-300 leading-relaxed">${f.desc}</p>
        </div>
      `).join('');

      // Bottom Video Gallery
      document.getElementById('el-bottomGalleryHeading').textContent = cfg.bottomGalleryHeading;
      document.getElementById('el-bottomVideosContainer').innerHTML = cfg.bottomVideos.map(v => {
        const vidId = parseYouTubeId(v.youtubeId);
        return `
          <div class="video-frame-glow">
            <div class="rounded-[1rem] bg-slate-950 overflow-hidden">
              <div class="px-3 py-1.5 bg-slate-900 text-center border-b border-white/10">
                <span class="text-[11px] font-extrabold tracking-wider text-amber-300">${v.badge}</span>
              </div>
              <div class="aspect-video w-full bg-black">
                <iframe
                  class="w-full h-full"
                  src="https://www.youtube.com/embed/${vidId}?rel=0"
                  title="${v.badge}"
                  loading="lazy"
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
            </div>
          </div>
        `;
      }).join('');

      // Closing & Sticky Prices
      document.getElementById('el-closingEyebrow').textContent = cfg.closingEyebrow;
      document.getElementById('el-closingTitleLine1').textContent = cfg.closingTitleLine1;
      document.getElementById('el-closingTitleLine2').textContent = cfg.closingTitleLine2;
      document.getElementById('el-closingDesc').textContent = cfg.closingDesc;
      document.getElementById('el-closingCtaText').textContent = cfg.closingCtaText;

      document.getElementById('el-originalPrice').textContent = formatRupiah(cfg.originalPrice);
      document.getElementById('el-discountPrice').textContent = formatRupiah(cfg.discountPrice);
      document.getElementById('el-stickyBuyText').textContent = cfg.stickyBuyText;
      document.getElementById('el-stickyPriceTag').textContent = formatRupiah(cfg.discountPrice);

      // Modal Checkout Info
      document.getElementById('modalProductTitle').textContent = `${cfg.titleLine1} ${cfg.titleLine2}`;
      document.getElementById('modalOriginalPrice').textContent = formatRupiah(cfg.originalPrice);
      document.getElementById('modalDiscountPrice').textContent = formatRupiah(cfg.discountPrice);
    }

    // Toast notification helper
    let toastTimer;
    function showToast(msg) {
      const box = document.getElementById('toastBox');
      document.getElementById('toastMessage').textContent = msg;
      box.classList.remove('opacity-0');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        box.classList.add('opacity-0');
      }, 2400);
    }

    // Add to Cart feedback
    function addToCartFeedback() {
      const badge = document.getElementById('cartBadge');
      badge.classList.remove('hidden');
      showToast('✓ Produk ditambahkan ke keranjang! Klik BUY NOW untuk lanjut.');
    }

    // Checkout Modal Controls
    function openCheckoutModal() {
      const modal = document.getElementById('checkoutModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeCheckoutModal() {
      const modal = document.getElementById('checkoutModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    // Submit Checkout -> Redirect to Lynk.id / Payment URL
    function handleOrderSubmit(e) {
      e.preventDefault();
      const name = document.getElementById('buyerName').value.trim();
      const wa = document.getElementById('buyerWhatsapp').value.trim();
      const email = document.getElementById('buyerEmail').value.trim();

      if (!name || !wa || !email) {
        showToast('Mohon lengkapi Nama, WhatsApp, dan Email.');
        return;
      }

      showToast('Mengarahkan ke halaman pembayaran...');
      setTimeout(() => {
        window.open(PRODUCT_CONFIG.checkoutUrl, '_blank', 'noopener,noreferrer');
      }, 600);
    }

    // Order via WhatsApp
    function orderViaWhatsApp() {
      const name = document.getElementById('buyerName').value.trim() || 'Calon Pembeli';
      const productName = `${PRODUCT_CONFIG.titleLine1} ${PRODUCT_CONFIG.titleLine2}`;
      const priceText = formatRupiah(PRODUCT_CONFIG.discountPrice);
      const text = encodeURIComponent(
        `Halo Admin, saya *${name}* ingin memesan produk:\n\n` +
        `📦 *${productName}*\n` +
        `💰 Harga Promo: *${priceText}*\n\n` +
        `Mohon info langkah aksesnya. Terima kasih!`
      );
      window.open(`https://wa.me/${PRODUCT_CONFIG.whatsappNumber}?text=${text}`, '_blank', 'noopener,noreferrer');
    }

    // Quick-Editor Controls
    function openQuickEditor() {
      document.getElementById('ed-title1').value = PRODUCT_CONFIG.titleLine1;
      document.getElementById('ed-title2').value = PRODUCT_CONFIG.titleLine2;
      document.getElementById('ed-subtitle').value = PRODUCT_CONFIG.subtitle;
      document.getElementById('ed-origPrice').value = PRODUCT_CONFIG.originalPrice;
      document.getElementById('ed-discPrice').value = PRODUCT_CONFIG.discountPrice;
      document.getElementById('ed-checkoutUrl').value = PRODUCT_CONFIG.checkoutUrl;
      document.getElementById('ed-wa').value = PRODUCT_CONFIG.whatsappNumber;
      document.getElementById('ed-yt1').value = PRODUCT_CONFIG.topVideos[0]?.youtubeId || '';
      document.getElementById('ed-yt2').value = PRODUCT_CONFIG.topVideos[1]?.youtubeId || '';

      const modal = document.getElementById('quickEditorModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeQuickEditor() {
      const modal = document.getElementById('quickEditorModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function applyQuickEditor() {
      PRODUCT_CONFIG.titleLine1 = document.getElementById('ed-title1').value.trim() || PRODUCT_CONFIG.titleLine1;
      PRODUCT_CONFIG.titleLine2 = document.getElementById('ed-title2').value.trim() || PRODUCT_CONFIG.titleLine2;
      PRODUCT_CONFIG.subtitle = document.getElementById('ed-subtitle').value.trim() || PRODUCT_CONFIG.subtitle;
      PRODUCT_CONFIG.originalPrice = Number(document.getElementById('ed-origPrice').value) || PRODUCT_CONFIG.originalPrice;
      PRODUCT_CONFIG.discountPrice = Number(document.getElementById('ed-discPrice').value) || PRODUCT_CONFIG.discountPrice;
      PRODUCT_CONFIG.checkoutUrl = document.getElementById('ed-checkoutUrl').value.trim() || PRODUCT_CONFIG.checkoutUrl;
      PRODUCT_CONFIG.whatsappNumber = document.getElementById('ed-wa').value.trim() || PRODUCT_CONFIG.whatsappNumber;

      const yt1 = document.getElementById('ed-yt1').value.trim();
      const yt2 = document.getElementById('ed-yt2').value.trim();
      if (yt1 && PRODUCT_CONFIG.topVideos[0]) PRODUCT_CONFIG.topVideos[0].youtubeId = yt1;
      if (yt2 && PRODUCT_CONFIG.topVideos[1]) PRODUCT_CONFIG.topVideos[1].youtubeId = yt2;

      renderLandingPage();
      closeQuickEditor();
      showToast('✓ Tampilan landing page berhasil diperbarui!');
    }

    // Salin HTML final dengan PRODUCT_CONFIG terbaru
    function copyFinalHtml() {
      applyQuickEditor();
      const updatedConfigJson = JSON.stringify(PRODUCT_CONFIG, null, 4);
      let fullHtml = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;

      // Replace objek PRODUCT_CONFIG dengan versi yang sudah diedit
      fullHtml = fullHtml.replace(
        /const PRODUCT_CONFIG = \{[\s\S]*?\};/,
        `const PRODUCT_CONFIG = ${updatedConfigJson};`
      );

      const tempArea = document.createElement('textarea');
      tempArea.value = fullHtml;
      document.body.appendChild(tempArea);
      tempArea.select();
      try {
        document.execCommand('copy');
        showToast('📋 Kode HTML lengkap berhasil disalin ke clipboard!');
      } catch (err) {
        showToast('Gagal menyalin otomatis. Gunakan tombol Download/Copy.');
      }
      document.body.removeChild(tempArea);
    }

    // Inisialisasi halaman saat selesai dimuat
    window.addEventListener('DOMContentLoaded', renderLandingPage);
  </script>
</body>
</html>
