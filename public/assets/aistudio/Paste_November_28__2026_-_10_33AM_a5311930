  </script>

  <!-- Floating Quick-Edit Creator Button (Dapat disembunyikan jika sudah siap publish) -->
  <button
    id="toggleEditorBtn"
    type="button"
    onclick="openQuickEditor()"
    title="Edit Teks, Harga & Link Produk"
    class="fixed top-3 right-3 z-40 flex items-center gap-1.5 rounded-full bg-slate-900/90 hover:bg-slate-800 text-cyan-300 border border-cyan-400/40 px-3 py-1.5 text-xs font-semibold shadow-lg backdrop-blur-md transition"
  >
    <span>⚙️</span>
    <span>Edit Halaman</span>
  </button>

  <!-- =====================================================================
       MOBILE-FIRST LANDING PAGE CONTAINER (MAX WIDTH 480PX SEPERTI LYNK.ID)
  ====================================================================== -->
  <main id="landingPageRoot" class="lp-canvas w-full max-w-[480px] min-h-screen shadow-2xl border-x border-white/10 pb-28 relative overflow-hidden">

    <!-- 1. HERO SECTION -->
    <section class="px-5 pt-11 pb-8 text-center relative">
      <!-- Ambient Top Glow -->
      <div class="pointer-events-none absolute -top-16 left-1/2 -translate-x-1/2 w-72 h-72 rounded-full bg-fuchsia-600/20 blur-3xl"></div>

      <div class="inline-flex items-center justify-center rounded-full border border-purple-400/35 bg-purple-950/60 px-4 py-1.5 mb-5 backdrop-blur-sm">
        <span id="el-badgeTop" class="text-[11px] font-bold tracking-wider uppercase text-purple-200"></span>
      </div>

      <h1 class="font-display font-black tracking-tight leading-[1.08] text-3xl sm:text-4xl mb-4">
        <span id="el-titleLine1" class="block text-white drop-shadow"></span>
        <span id="el-titleLine2" class="block bg-gradient-to-r from-cyan-400 via-sky-400 to-fuchsia-400 bg-clip-text text-transparent"></span>
      </h1>

      <p id="el-subtitle" class="text-slate-300 text-sm leading-relaxed max-w-sm mx-auto mb-6"></p>

      <!-- Pill Highlight -->
      <div class="mb-4">
        <span id="el-pillBadge" class="inline-block rounded-full bg-gradient-to-r from-cyan-500 to-indigo-600 px-5 py-2 text-[11px] font-extrabold tracking-wide text-white shadow-glowCyan"></span>
      </div>

      <!-- Primary Hero CTA Button -->
      <button
        type="button"
        onclick="openCheckoutModal()"
        class="cta-gradient-btn w-full max-w-xs mx-auto rounded-full py-3.5 px-6 font-display font-extrabold text-sm tracking-wide text-white shadow-glowPink flex items-center justify-center gap-2 cursor-pointer"
      >
        <span id="el-heroCtaText"></span>
      </button>

      <p id="el-heroMicroCopy" class="text-[11px] text-slate-400 mt-3"></p>
    </section>

    <!-- 2. LIHAT HASILNYA (TOP VIDEO SHOWCASE) -->
    <section class="px-5 py-6">
      <div class="text-center mb-5">
        <h2 id="el-showcaseHeading" class="font-display font-extrabold text-xl tracking-tight text-white"></h2>
        <p id="el-showcaseSubheading" class="text-xs text-slate-400 mt-1"></p>
      </div>

      <div id="el-topVideosContainer" class="space-y-4">
        <!-- Video cards injected by JS -->
      </div>
    </section>

    <!-- 3. PAIN POINTS CARD ("MASIH RIBET BIKIN KONTEN?") -->
    <section class="px-5 py-5">
      <div class="rounded-2xl bg-gradient-to-b from-fuchsia-950/45 to-slate-950/75 border border-pink-500/25 p-5 shadow-xl backdrop-blur-sm">
        <h2 id="el-painHeading" class="font-display font-extrabold text-lg text-pink-400 leading-snug mb-4"></h2>
        <ul id="el-painList" class="divide-y divide-white/10 text-sm text-slate-200">
          <!-- Pain items injected by JS -->
        </ul>
      </div>
    </section>

    <!-- 4. SOLUTION BRIDGE & FITUR UTAMA -->
    <section class="px-5 py-7">
      <div class="text-center mb-7">
        <p id="el-solutionEyebrow" class="text-[11px] font-bold uppercase tracking-widest text-cyan-400 mb-2"></p>
        <h2 class="font-display font-black text-2xl sm:text-[26px] leading-tight">
          <span id="el-solutionTitlePart1" class="text-fuchsia-400"></span>
          <span class="text-white"> MENJADI</span><br />
          <span id="el-solutionTitlePart2" class="text-cyan-400"></span>
        </h2>
        <p id="el-solutionDesc" class="text-xs sm:text-sm text-slate-300 leading-relaxed mt-3 max-w-sm mx-auto"></p>
      </div>

      <div class="text-center mb-4">
        <h3 id="el-featuresHeading" class="font-display font-extrabold text-xl text-white"></h3>
        <p id="el-featuresSubheading" class="text-xs text-slate-400 mt-1"></p>
      </div>

      <div id="el-featuresList" class="space-y-3">
        <!-- Feature cards injected by JS -->
      </div>
    </section>

    <!-- 5. CONTOH HASIL GENERATE (BOTTOM VIDEO GALLERY) -->
    <section class="px-5 py-6">
      <div class="text-center mb-5">
        <h2 id="el-bottomGalleryHeading" class="font-display font-extrabold text-xl tracking-tight text-cyan-300"></h2>
      </div>

      <div id="el-bottomVideosContainer" class="space-y-5">
        <!-- Bottom video showcase injected by JS -->
      </div>
    </section>

