        <h2 class="font-display font-black text-2xl leading-tight mb-3">
          <span id="el-closingTitleLine1" class="block text-white"></span>
          <span id="el-closingTitleLine2" class="block text-cyan-400"></span>
        </h2>
        <p id="el-closingDesc" class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-5"></p>

        <!-- Price Display Box -->
        <div class="rounded-2xl bg-black/40 border border-white/10 py-3 px-4 mb-5">
          <p class="text-[11px] uppercase tracking-wider text-slate-400">Harga Promo Hari Ini</p>
          <div class="flex items-center justify-center gap-2.5 mt-0.5">
            <span id="el-originalPrice" class="text-sm text-slate-400 line-through"></span>
            <span id="el-discountPrice" class="font-display font-black text-2xl text-emerald-400"></span>
          </div>
        </div>

        <button
          type="button"
          onclick="openCheckoutModal()"
          class="cta-gradient-btn w-full rounded-full py-3.5 px-6 font-display font-extrabold text-sm tracking-wide text-white shadow-glowPink cursor-pointer"
        >
          <span id="el-closingCtaText"></span>
        </button>
      </div>
    </section>

  </main>

  <!-- =====================================================================
       STICKY BOTTOM BAR (IDENTIK DENGAN TOMBOL KERANJANG & BUY NOW LYNK.ID)
  ====================================================================== -->
  <div class="fixed bottom-0 left-1/2 -translate-x-1/2 w-full max-w-[480px] z-30 bg-white/95 backdrop-blur-md border-t border-slate-200 px-3 py-2.5 shadow-[0_-8px_25px_rgba(0,0,0,0.35)]">
    <div class="flex items-center gap-2.5">
      <!-- Add to Cart Icon Button -->
      <button
        type="button"
        onclick="addToCartFeedback()"
        aria-label="Tambah ke Keranjang"
        class="relative flex items-center justify-center w-12 h-11 rounded-xl border border-emerald-500/40 bg-emerald-50 hover:bg-emerald-100 text-emerald-600 transition active:scale-95 cursor-pointer shrink-0"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        <span id="cartBadge" class="hidden absolute -top-1.5 -right-1.5 w-5 h-5 rounded-full bg-emerald-600 text-white text-[10px] font-bold flex items-center justify-center">1</span>
      </button>

      <!-- Red BUY NOW Button -->
      <button
        type="button"
        onclick="openCheckoutModal()"
        class="flex-1 h-11 rounded-xl bg-[#b91c1c] hover:bg-[#991b1b] active:scale-[0.99] text-white font-display font-extrabold text-sm tracking-wider uppercase shadow-md transition flex items-center justify-center gap-2 cursor-pointer"
      >
        <span id="el-stickyBuyText">BUY NOW</span>
        <span id="el-stickyPriceTag" class="text-xs font-semibold bg-black/25 px-2 py-0.5 rounded-md"></span>
      </button>
    </div>
  </div>

  <!-- Toast Notification (Pengganti alert()) -->
  <div id="toastBox" class="fixed bottom-20 left-1/2 -translate-x-1/2 z-50 pointer-events-none opacity-0 transition-opacity duration-200">
    <div id="toastMessage" class="rounded-full bg-slate-900 text-white border border-emerald-400/50 px-4 py-2 text-xs font-semibold shadow-xl whitespace-nowrap"></div>
  </div>

  <!-- =====================================================================
       INTERACTIVE CHECKOUT / ORDER MODAL
  ====================================================================== -->
  <div id="checkoutModal" class="fixed inset-0 z-50 hidden items-end sm:items-center justify-center bg-black/75 backdrop-blur-sm p-0 sm:p-4">
    <div class="w-full max-w-[460px] rounded-t-3xl sm:rounded-3xl bg-slate-900 border border-white/15 text-slate-100 p-5 sm:p-6 shadow-2xl animate-fadeIn">
      <div class="flex items-center justify-between pb-3 border-b border-white/10">
        <div>
          <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-400">Checkout Instan</span>
          <h3 id="modalProductTitle" class="font-display font-extrabold text-base text-white"></h3>
        </div>
        <button type="button" onclick="closeCheckoutModal()" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-slate-300 cursor-pointer">✕</button>
      </div>

      <!-- Ringkasan Harga -->
      <div class="mt-4 rounded-2xl bg-slate-950/80 border border-white/10 p-3.5 flex items-center justify-between">
        <div>
          <p class="text-xs text-slate-400">Total Pembayaran</p>
          <p id="modalOriginalPrice" class="text-xs text-slate-500 line-through"></p>
        </div>
        <div class="text-right">
          <span id="modalDiscountPrice" class="font-display font-black text-xl text-emerald-400"></span>
          <span class="block text-[10px] text-cyan-300">Akses Otomatis Terkirim</span>
        </div>
      </div>

      <!-- Form Data Pembeli -->
      <form id="orderForm" onsubmit="handleOrderSubmit(event)" class="mt-4 space-y-3">
        <div>
          <label class="block text-xs font-medium text-slate-300 mb-1">Nama Lengkap *</label>
          <input
            type="text"
            id="buyerName"
            required
            placeholder="Contoh: Budi Santoso"
            class="w-full rounded-xl bg-slate-800/90 border border-white/15 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-cyan-400"
          />
        </div>

        <div>
          <label class="block text-xs font-medium text-slate-300 mb-1">Nomor WhatsApp Aktif *</label>
          <input
            type="tel"
            id="buyerWhatsapp"
            required
            placeholder="Contoh: 081234567890"
            class="w-full rounded-xl bg-slate-800/90 border border-white/15 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-cyan-400"
          />
        </div>

        <div>
          <label class="block text-xs font-medium text-slate-300 mb-1">Alamat Email (Untuk Pengiriman Akses) *</label>
          <input
            type="email"
            id="buyerEmail"
            required
            placeholder="nama@email.com"
            class="w-full rounded-xl bg-slate-800/90 border border-white/15 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-cyan-400"
          />
        </div>

        <div class="pt-2 space-y-2.5">
          <!-- Tombol Lanjut ke Lynk.id / Payment Gateway -->
          <button
            type="submit"
            class="w-full rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 py-3 px-4 font-display font-extrabold text-sm text-white shadow-lg transition cursor-pointer"
          >
            Lanjutkan Pembayaran →
          </button>

          <!-- Alternatif Order via WhatsApp -->
          <button
            type="button"
            onclick="orderViaWhatsApp()"
            class="w-full rounded-xl bg-white/10 hover:bg-white/15 border border-white/15 py-2.5 px-4 text-xs font-semibold text-slate-200 transition cursor-pointer"
          >
            💬 Pesan / Tanya Admin via WhatsApp
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- =====================================================================
       QUICK-EDIT DRAWER MODAL (UNTUK KUSTOMISASI & EXPORT HTML SIAP DEPLOY)
  ====================================================================== -->
  <div id="quickEditorModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-sm p-3">
    <div class="w-full max-w-lg max-h-[90vh] flex flex-col rounded-3xl bg-slate-900 border border-cyan-400/30 text-slate-100 shadow-2xl overflow-hidden">
      <div class="flex items-center justify-between px-5 py-4 border-b border-white/10 bg-slate-950/60">
        <div>
          <h3 class="font-display font-extrabold text-base text-cyan-300">⚙️ Quick-Edit Landing Page</h3>
          <p class="text-[11px] text-slate-400">Ubah konten langsung & salin kode HTML siap upload ke GitHub Pages</p>
        </div>
        <button type="button" onclick="closeQuickEditor()" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-slate-300 cursor-pointer">✕</button>
      </div>

      <div class="p-5 overflow-y-auto space-y-4 text-xs">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-400 mb-1">Judul Baris 1</label>
            <input id="ed-title1" type="text" class="w-full rounded-lg bg-slate-800 border border-white/15 px-3 py-2 text-white" />
          </div>
          <div>
            <label class="block text-slate-400 mb-1">Judul Baris 2 (Highlight)</label>
            <input id="ed-title2" type="text" class="w-full rounded-lg bg-slate-800 border border-white/15 px-3 py-2 text-white" />
          </div>
        </div>

        <div>
          <label class="block text-slate-400 mb-1">Subjudul Hero</label>
          <textarea id="ed-subtitle" rows="2" class="w-full rounded-lg bg-slate-800 border border-white/15 px-3 py-2 text-white"></textarea>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-400 mb-1">Harga Coret (IDR)</label>
            <input id="ed-origPrice" type="number" class="w-full rounded-lg bg-slate-800 border border-white/15 px-3 py-2 text-white" />
          </div>
          <div>
            <label class="block text-slate-400 mb-1">Harga Promo (IDR)</label>
            <input id="ed-discPrice" type="number" class="w-full rounded-lg bg-slate-800 border border-white/15 px-3 py-2 text-white" />
