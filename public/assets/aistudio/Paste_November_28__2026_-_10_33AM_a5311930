        }
      ],

      // 7. Penutup (Closing CTA) & Bar Bawah
      closingEyebrow: "✨ READY TO CREATE?",
      closingTitleLine1: "SAATNYA BIKIN KONTEN",
      closingTitleLine2: "LEBIH SERU.",
      closingDesc: "Mulai eksplorasi pembuatan konten animasi profesional sekarang juga sebelum harga promo berakhir.",
      closingCtaText: "🚀 AKSES SEKARANG JUGA",
      stickyBuyText: "BUY NOW"
