  <style>
    /* Custom styling for deep dark gradient canvas & subtle glow animations */
    body {
      background-color: #07070f;
      color: #f8fafc;
      -webkit-tap-highlight-color: transparent;
    }

    .lp-canvas {
      background:
        radial-gradient(circle at 50% 0%, rgba(124, 58, 237, 0.28) 0%, rgba(14, 16, 38, 0) 48%),
        radial-gradient(circle at 85% 32%, rgba(6, 182, 212, 0.16) 0%, rgba(14, 16, 38, 0) 40%),
        radial-gradient(circle at 15% 65%, rgba(236, 72, 153, 0.16) 0%, rgba(14, 16, 38, 0) 45%),
        linear-gradient(180deg, #130c2e 0%, #0b0d21 35%, #110b29 70%, #090a1a 100%);
    }

    .video-frame-glow {
      position: relative;
      border-radius: 1.15rem;
      padding: 2px;
      background: linear-gradient(135deg, rgba(34, 211, 238, 0.75), rgba(168, 85, 247, 0.65), rgba(249, 115, 22, 0.75));
      box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.8);
    }

    .cta-gradient-btn {
      background: linear-gradient(90deg, #ec4899 0%, #f97316 100%);
      transition: transform 0.18s ease, box-shadow 0.18s ease;
    }

    .cta-gradient-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 10px 28px rgba(249, 115, 22, 0.45);
    }

    .cta-gradient-btn:active {
      transform: scale(0.98);
    }

    /* Hide scrollbar cleanly inside editor modal */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-start antialiased selection:bg-pink-500 selection:text-white">

