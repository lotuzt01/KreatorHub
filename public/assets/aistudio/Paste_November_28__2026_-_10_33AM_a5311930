        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-400 mb-1">Link Checkout (Lynk.id / Payment)</label>
            <input id="ed-checkoutUrl" type="url" class="w-full rounded-lg bg-slate-800 border border-white/15 px-3 py-2 text-white" />
          </div>
          <div>
            <label class="block text-slate-400 mb-1">Nomor WhatsApp (628...)</label>
            <input id="ed-wa" type="text" class="w-full rounded-lg bg-slate-800 border border-white/15 px-3 py-2 text-white" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-400 mb-1">ID Video YouTube #1</label>
            <input id="ed-yt1" type="text" placeholder="Contoh: aqz-KE-bpKQ" class="w-full rounded-lg bg-slate-800 border border-white/15 px-3 py-2 text-white" />
          </div>
          <div>
            <label class="block text-slate-400 mb-1">ID Video YouTube #2</label>
            <input id="ed-yt2" type="text" placeholder="Contoh: LXb3EKWsInQ" class="w-full rounded-lg bg-slate-800 border border-white/15 px-3 py-2 text-white" />
