# GEMINI_API_KEY: Optional for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (Vercel, Netlify, GitHub Pages, or Cloud Run).
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional fixed passcode for Admin Dashboard sign-in and Vercel API test endpoints.
# If left empty on a Node server, you can claim your own admin password securely on first run.
ADMIN_PASSCODE=

# TELEGRAM_BOT_TOKEN: Bot token from @BotFather for real-time order notifications.
TELEGRAM_BOT_TOKEN=

# TELEGRAM_CHAT_ID: Target Telegram chat, group, or channel ID to receive order alerts.
TELEGRAM_CHAT_ID=

# MIDTRANS_SERVER_KEY: Optional Midtrans Server Key for live QRIS / Virtual Account payment links.
MIDTRANS_SERVER_KEY=

# MIDTRANS_IS_PRODUCTION: Set to "true" for live Midtrans production mode, leave empty or "false" for Sandbox.
MIDTRANS_IS_PRODUCTION=false

# PAYMENT_WEBHOOK_SECRET: Optional shared secret for verifying automated payment gateway callbacks.
PAYMENT_WEBHOOK_SECRET=

# ALLOWED_ORIGIN: Optional allowed frontend origin for cross-origin calls (e.g. https://lotuzt01.github.io).
ALLOWED_ORIGIN=
